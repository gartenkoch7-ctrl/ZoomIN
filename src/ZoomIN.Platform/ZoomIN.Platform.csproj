<Project Sdk="Microsoft.NET.Sdk">
  <!-- Win32, UI Automation, hooks, monitors, DPI, settings storage. References Core only. -->
  <PropertyGroup>
    <TargetFramework>$(ZoomInWindowsTfm)</TargetFramework>
    <SupportedOSPlatformVersion>$(ZoomInMinWindows)</SupportedOSPlatformVersion>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- APPBARDATA's layout depends on the CPU; ZoomIN ships x64 only (ADR-0009). -->
    <CsWin32PlatformTarget>x64</CsWin32PlatformTarget>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\ZoomIN.Core\ZoomIN.Core.csproj" />
    <InternalsVisibleTo Include="ZoomIN.Platform.Tests" />
    <InternalsVisibleTo Include="ZoomIN.TrackingProbe" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Windows.CsWin32" PrivateAssets="all" />
  </ItemGroup>
</Project>
