<Project Sdk="Microsoft.NET.Sdk">
  <!-- Composition root, WinUI 3 UI and tray. References Core, Platform and Rendering. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>$(ZoomInWindowsTfm)</TargetFramework>
    <TargetPlatformMinVersion>$(ZoomInMinWindows)</TargetPlatformMinVersion>
    <SupportedOSPlatformVersion>$(ZoomInMinWindows)</SupportedOSPlatformVersion>
    <RootNamespace>ZoomIN.App</RootNamespace>
    <AssemblyName>ZoomIN</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- Installer build (publish.ps1 -UiAccess, ADR-0012): overlay above shell flyouts. Needs a
         signed exe in Program Files, so it is off for dev builds and the portable ZIP. -->
    <ApplicationManifest Condition="'$(ZoomInUiAccess)' == 'true'">app.uiaccess.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\ZoomIN.ico</ApplicationIcon>
    <!-- Overridden by scripts/publish.ps1 (-Version) for releases. -->
    <Version>1.0.0-rc1</Version>
    <!-- x64 only in the MVP (ADR-0009). -->
    <Platforms>x64</Platforms>
    <RuntimeIdentifiers>win-x64</RuntimeIdentifiers>
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == ''">win-x64</RuntimeIdentifier>
    <UseWinUI>true</UseWinUI>
    <EnableMsixTooling>true</EnableMsixTooling>
    <!-- Unpackaged + self-contained: runs from a folder/ZIP without installing the runtime. -->
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <SelfContained>true</SelfContained>
    <!-- ZoomIN ships German and English only; skip the framework's other UI languages. -->
    <SatelliteResourceLanguages>de;en</SatelliteResourceLanguages>
    <!-- Own Program.Main: the same exe also runs as watchdog (ADR-0007). -->
    <DefineConstants>$(DefineConstants);DISABLE_XAML_GENERATED_MAIN</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\ZoomIN.Core\ZoomIN.Core.csproj" />
    <ProjectReference Include="..\ZoomIN.Platform\ZoomIN.Platform.csproj" />
    <ProjectReference Include="..\ZoomIN.Rendering\ZoomIN.Rendering.csproj" />
    <ProjectReference Include="..\ZoomIN.Watchdog\ZoomIN.Watchdog.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Loaded at runtime by the tray icon and the settings window. -->
    <Content Include="Assets\ZoomIN.ico" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK.WinUI" />
    <!-- Direct, so the [LoggerMessage] source generator runs here too (ADR-0019). -->
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
    <PackageReference Include="Microsoft.WindowsAppSDK.Foundation" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
    <PackageReference Include="CommunityToolkit.Mvvm" />
  </ItemGroup>

  <!-- The Windows App SDK merges our manifest into obj\...\Manifests\app.manifest only when that file is
       older than its inputs, so switching app.manifest <-> app.uiaccess.manifest silently kept the
       stale merge (no uiAccess in the exe). Remember which manifest was merged; on change, delete the
       merge so CreateWinRTRegistration runs again. -->
  <Target Name="ZoomInRefreshMergedManifest" BeforeTargets="CreateWinRTRegistration" DependsOnTargets="GetNewAppManifestValues">
    <PropertyGroup>
      <ZoomInManifestMarker>$(SelfContainedIntermediateOutputPath)Manifests\merged-from.txt</ZoomInManifestMarker>
      <ZoomInLastManifest Condition="Exists('$(ZoomInManifestMarker)')">$([System.IO.File]::ReadAllText('$(ZoomInManifestMarker)').Trim())</ZoomInLastManifest>
    </PropertyGroup>
    <Delete Files="$(ApplicationManifest)" Condition="'$(ZoomInLastManifest)' != '$(UserApplicationManifest)'" />
    <MakeDir Directories="$(SelfContainedIntermediateOutputPath)Manifests\" />
    <WriteLinesToFile File="$(ZoomInManifestMarker)" Lines="$(UserApplicationManifest)" Overwrite="true" WriteOnlyWhenDifferent="true" />
  </Target>
</Project>
