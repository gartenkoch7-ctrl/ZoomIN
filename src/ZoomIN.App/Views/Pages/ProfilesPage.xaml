<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="ZoomIN.App.Views.Pages.ProfilesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:loc="using:ZoomIN.App.Localization">

    <ScrollViewer>
        <StackPanel MaxWidth="680" HorizontalAlignment="Left" Spacing="16">
            <TextBlock Style="{StaticResource TitleTextBlockStyle}" Text="{x:Bind loc:Text.NavProfiles}" />

            <StackPanel Orientation="Horizontal" Spacing="8">
                <TextBlock Text="{x:Bind loc:Text.ProfilesActive}" />
                <TextBlock FontWeight="SemiBold" Text="{x:Bind Vm.Active, Mode=OneWay}" />
            </StackPanel>

            <ListView
                MinHeight="160"
                MaxHeight="280"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                ItemsSource="{x:Bind Vm.Names}"
                SelectedItem="{x:Bind Vm.Selected, Mode=TwoWay}" />

            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button Click="OnActivate" Content="{x:Bind loc:Text.ProfilesActivate}" Style="{StaticResource AccentButtonStyle}" />
                <Button Click="OnDelete" Content="{x:Bind loc:Text.ProfilesDelete}" />
                <Button Click="OnExport" Content="{x:Bind loc:Text.ProfilesExport}" />
                <Button Click="OnImport" Content="{x:Bind loc:Text.ProfilesImport}" />
            </StackPanel>

            <TextBox Header="{x:Bind loc:Text.ProfilesName}" Text="{x:Bind Vm.NewName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button Click="OnCreate" Content="{x:Bind loc:Text.ProfilesCreate}" />
                <Button Click="OnRename" Content="{x:Bind loc:Text.ProfilesRename}" />
            </StackPanel>

            <TextBlock
                Foreground="{ThemeResource SystemFillColorCautionBrush}"
                Text="{x:Bind Vm.Message, Mode=OneWay}"
                TextWrapping="Wrap" />
        </StackPanel>
    </ScrollViewer>
</Page>
