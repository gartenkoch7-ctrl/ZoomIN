<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="ZoomIN.App.Views.Pages.InfoPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:c="using:ZoomIN.App.Views.Controls"
    xmlns:loc="using:ZoomIN.App.Localization">

    <ScrollViewer>
        <StackPanel MaxWidth="{StaticResource PageMaxWidth}" Style="{StaticResource CardStackStyle}">
            <TextBlock Style="{StaticResource PageTitleStyle}" Text="{x:Bind loc:Text.NavInfo}" />

            <InfoBar x:Name="ErrorBar" Title="{x:Bind loc:Text.InfoError}" IsClosable="False" Severity="Error" />

            <c:SettingCard Glyph="&#xE71E;" Header="{x:Bind loc:Text.InfoZoom}">
                <TextBlock x:Name="ZoomText" MaxWidth="460" TextAlignment="Right" TextWrapping="Wrap" />
            </c:SettingCard>
            <c:SettingCard Glyph="&#xE9D9;" Header="{x:Bind loc:Text.InfoFps}">
                <TextBlock x:Name="FpsText" />
            </c:SettingCard>
            <c:SettingCard Description="{x:Bind loc:Text.Get('InfoCapture.Desc')}" Glyph="&#xE72E;" Header="{x:Bind loc:Text.InfoCapture}">
                <TextBlock x:Name="CaptureText" />
            </c:SettingCard>
            <c:SettingCard Glyph="&#xE946;" Header="{x:Bind loc:Text.InfoVersion}">
                <TextBlock x:Name="VersionText" IsTextSelectionEnabled="True" />
            </c:SettingCard>
            <c:SettingCard Glyph="&#xE8B7;" Header="{x:Bind loc:Text.Get('InfoLogsTitle')}">
                <Button Click="OnOpenLogs" Content="{x:Bind loc:Text.InfoLogs}" />
            </c:SettingCard>
            <c:SettingCard Description="{x:Bind loc:Text.InfoLicense}" Glyph="&#xE8A1;" Header="ZoomIN" />
        </StackPanel>
    </ScrollViewer>
</Page>
