<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="ZoomIN.App.Views.Pages.ZoomPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:c="using:ZoomIN.App.Views.Controls"
    xmlns:loc="using:ZoomIN.App.Localization">

    <ScrollViewer>
        <StackPanel MaxWidth="{StaticResource PageMaxWidth}" Style="{StaticResource CardStackStyle}">
            <TextBlock Style="{StaticResource PageTitleStyle}" Text="{x:Bind loc:Text.NavZoom}" />

            <c:SettingCard Description="{x:Bind loc:Text.Get('ZoomMode.Desc')}" Glyph="&#xE71E;" Header="{x:Bind loc:Text.ZoomMode}">
                <ComboBox MinWidth="200" SelectedIndex="{x:Bind Vm.ModeIndex, Mode=TwoWay}">
                    <ComboBoxItem Content="{x:Bind loc:Text.ModeFullscreen}" />
                    <ComboBoxItem Content="{x:Bind loc:Text.ModeLens}" />
                    <ComboBoxItem Content="{x:Bind loc:Text.ModeDocked}" />
                </ComboBox>
            </c:SettingCard>
            <c:SettingCard Description="{x:Bind loc:Text.Get('ZoomPerMonitor.Desc')}" Glyph="&#xE7F4;" Header="{x:Bind loc:Text.ZoomPerMonitor}">
                <ToggleSwitch IsOn="{x:Bind Vm.PerMonitor, Mode=TwoWay}" />
            </c:SettingCard>
            <c:SettingCard Description="{x:Bind loc:Text.Get('ZoomAnimation.Desc')}" Glyph="&#xE916;" Header="{x:Bind loc:Text.Get('ZoomAnimationTitle')}">
                <c:ValueSlider Format="{}{0:0} ms" Maximum="500" Minimum="0" Step="10" Value="{x:Bind Vm.AnimationMs, Mode=TwoWay}" />
            </c:SettingCard>
            <c:SettingCard Description="{x:Bind loc:Text.Get('ZoomSmoothing.Desc')}" Glyph="&#xE8D2;" Header="{x:Bind loc:Text.ZoomSmoothing}">
                <ComboBox MinWidth="200" SelectedIndex="{x:Bind Vm.SmoothingIndex, Mode=TwoWay}">
                    <ComboBoxItem Content="{x:Bind loc:Text.SmoothingText}" />
                    <ComboBoxItem Content="{x:Bind loc:Text.SmoothingSoft}" />
                    <ComboBoxItem Content="{x:Bind loc:Text.SmoothingPixel}" />
                </ComboBox>
            </c:SettingCard>

            <TextBlock Style="{StaticResource GroupHeaderStyle}" Text="{x:Bind loc:Text.Get('Drag.Title')}" />
            <c:SettingCard Description="{x:Bind loc:Text.Get('Drag.Action.Desc')}" Glyph="&#xE7C4;" Header="{x:Bind loc:Text.Get('Drag.Action')}">
                <ComboBox MinWidth="200" SelectedIndex="{x:Bind Drag.ActionIndex, Mode=TwoWay}">
                    <ComboBoxItem Content="{x:Bind loc:Text.Get('Drag.Lift')}" />
                    <ComboBoxItem Content="{x:Bind loc:Text.Get('Drag.Lower')}" />
                    <ComboBoxItem Content="{x:Bind loc:Text.Get('Drag.Unchanged')}" />
                </ComboBox>
            </c:SettingCard>
            <!-- Range and step as WindowDragOptions.MinLowerLevel/MaxLowerLevel/LowerLevelStep. -->
            <c:SettingCard Description="{x:Bind loc:Text.Get('Drag.Level.Desc')}" Glyph="&#xE71F;" Header="{x:Bind loc:Text.Get('Drag.Level')}" Visibility="{x:Bind Drag.IsLower, Mode=OneWay}">
                <c:ValueSlider Format="{}{0:0.0} ×" Maximum="8" Minimum="1.5" Step="0.5" Value="{x:Bind Drag.LowerLevel, Mode=TwoWay}" />
            </c:SettingCard>
            <c:SettingCard Description="{x:Bind loc:Text.Get('Drag.OnMove.Desc')}" Glyph="&#xE7C2;" Header="{x:Bind loc:Text.Get('Drag.OnMove')}">
                <ToggleSwitch IsEnabled="{x:Bind Drag.Acts, Mode=OneWay}" IsOn="{x:Bind Drag.OnMove, Mode=TwoWay}" />
            </c:SettingCard>
            <c:SettingCard Description="{x:Bind loc:Text.Get('Drag.OnResize.Desc')}" Glyph="&#xE740;" Header="{x:Bind loc:Text.Get('Drag.OnResize')}">
                <ToggleSwitch IsEnabled="{x:Bind Drag.Acts, Mode=OneWay}" IsOn="{x:Bind Drag.OnResize, Mode=TwoWay}" />
            </c:SettingCard>

            <TextBlock Style="{StaticResource GroupHeaderStyle}" Text="{x:Bind loc:Text.ModeLens}" />
            <c:SettingCard Description="{x:Bind loc:Text.Get('ZoomLensSize.Desc')}" Glyph="&#xE721;" Header="{x:Bind loc:Text.Get('ZoomLensWidthTitle')}">
                <c:ValueSlider Format="{}{0:0} %" Maximum="90" Minimum="10" Step="5" Value="{x:Bind Vm.LensWidth, Mode=TwoWay}" />
            </c:SettingCard>
            <c:SettingCard Glyph="&#xE721;" Header="{x:Bind loc:Text.Get('ZoomLensHeightTitle')}">
                <c:ValueSlider Format="{}{0:0} %" Maximum="90" Minimum="10" Step="5" Value="{x:Bind Vm.LensHeight, Mode=TwoWay}" />
            </c:SettingCard>

            <TextBlock Style="{StaticResource GroupHeaderStyle}" Text="{x:Bind loc:Text.ModeDocked}" />
            <c:SettingCard Description="{x:Bind loc:Text.Get('ZoomDockEdge.Desc')}" Glyph="&#xE90C;" Header="{x:Bind loc:Text.ZoomDockEdge}">
                <ComboBox MinWidth="200" SelectedIndex="{x:Bind Vm.DockEdgeIndex, Mode=TwoWay}">
                    <ComboBoxItem Content="{x:Bind loc:Text.DockTop}" />
                    <ComboBoxItem Content="{x:Bind loc:Text.DockBottom}" />
                    <ComboBoxItem Content="{x:Bind loc:Text.DockLeft}" />
                    <ComboBoxItem Content="{x:Bind loc:Text.DockRight}" />
                </ComboBox>
            </c:SettingCard>
            <c:SettingCard Glyph="&#xE90C;" Header="{x:Bind loc:Text.Get('ZoomDockSizeTitle')}">
                <c:ValueSlider Format="{}{0:0} %" Maximum="70" Minimum="15" Step="5" Value="{x:Bind Vm.DockSize, Mode=TwoWay}" />
            </c:SettingCard>
        </StackPanel>
    </ScrollViewer>
</Page>
