<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="ZoomIN.App.Views.Pages.GeneralPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:c="using:ZoomIN.App.Views.Controls"
    xmlns:loc="using:ZoomIN.App.Localization">

    <ScrollViewer>
        <StackPanel MaxWidth="{StaticResource PageMaxWidth}" Style="{StaticResource CardStackStyle}">
            <TextBlock Style="{StaticResource PageTitleStyle}" Text="{x:Bind loc:Text.NavGeneral}" />

            <c:SettingCard Glyph="&#xF2B7;" Header="{x:Bind loc:Text.GeneralLanguage}">
                <ComboBox MinWidth="200" SelectedIndex="{x:Bind Vm.LanguageIndex, Mode=TwoWay}">
                    <ComboBoxItem Content="{x:Bind loc:Text.LanguageSystem}" />
                    <ComboBoxItem Content="Deutsch" />
                    <ComboBoxItem Content="English" />
                </ComboBox>
            </c:SettingCard>
            <c:SettingCard Description="{x:Bind loc:Text.Get('GeneralAutostart.Desc')}" Glyph="&#xE7E8;" Header="{x:Bind loc:Text.GeneralAutostart}">
                <ToggleSwitch IsOn="{x:Bind Vm.Autostart, Mode=TwoWay}" />
            </c:SettingCard>

            <TextBlock Style="{StaticResource GroupHeaderStyle}" Text="{x:Bind loc:Text.Get('GeneralGroupUpdates')}" />
            <c:SettingCard Description="{x:Bind loc:Text.GeneralUpdatesHint}" Glyph="&#xE895;" Header="{x:Bind loc:Text.GeneralUpdates}">
                <ToggleSwitch IsOn="{x:Bind Vm.CheckUpdates, Mode=TwoWay}" />
            </c:SettingCard>
            <c:SettingCard Glyph="&#xE71B;" Header="{x:Bind loc:Text.GeneralUpdateUrl}" HorizontalContentAlignment="Stretch">
                <TextBox
                    MinWidth="320"
                    PlaceholderText="https://api.github.com/repos/…/releases/latest"
                    Text="{x:Bind Vm.UpdateUrl, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" />
            </c:SettingCard>
        </StackPanel>
    </ScrollViewer>
</Page>
