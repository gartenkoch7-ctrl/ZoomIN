<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="ZoomIN.App.Views.Pages.GeneralPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:loc="using:ZoomIN.App.Localization">

    <ScrollViewer>
        <StackPanel MaxWidth="680" HorizontalAlignment="Left" Spacing="20">
            <TextBlock Style="{StaticResource TitleTextBlockStyle}" Text="{x:Bind loc:Text.NavGeneral}" />

            <ComboBox
                MinWidth="280"
                Header="{x:Bind loc:Text.GeneralLanguage}"
                SelectedIndex="{x:Bind Vm.LanguageIndex, Mode=TwoWay}">
                <ComboBoxItem Content="{x:Bind loc:Text.LanguageSystem}" />
                <ComboBoxItem Content="Deutsch" />
                <ComboBoxItem Content="English" />
            </ComboBox>

            <ToggleSwitch Header="{x:Bind loc:Text.GeneralAutostart}" IsOn="{x:Bind Vm.Autostart, Mode=TwoWay}" />

            <StackPanel Spacing="6">
                <ToggleSwitch Header="{x:Bind loc:Text.GeneralUpdates}" IsOn="{x:Bind Vm.CheckUpdates, Mode=TwoWay}" />
                <TextBlock
                    Style="{StaticResource CaptionTextBlockStyle}"
                    Text="{x:Bind loc:Text.GeneralUpdatesHint}"
                    TextWrapping="Wrap" />
            </StackPanel>

            <TextBox
                Header="{x:Bind loc:Text.GeneralUpdateUrl}"
                PlaceholderText="https://api.github.com/repos/…/releases/latest"
                Text="{x:Bind Vm.UpdateUrl, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" />
        </StackPanel>
    </ScrollViewer>
</Page>
