<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="ZoomIN.App.Views.Pages.PointerPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:c="using:ZoomIN.App.Views.Controls"
    xmlns:loc="using:ZoomIN.App.Localization">

    <ScrollViewer>
        <StackPanel MaxWidth="{StaticResource PageMaxWidth}" Style="{StaticResource CardStackStyle}">
            <TextBlock Style="{StaticResource PageTitleStyle}" Text="{x:Bind loc:Text.Get('NavPointer')}" />

            <!-- Live preview: the real Windows arrow with the chosen style, on light and dark. -->
            <Grid
                Padding="16"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                ColumnSpacing="12"
                CornerRadius="{StaticResource OverlayCornerRadius}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Border Height="150" Background="#F3F3F3" CornerRadius="4">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Orientation="Horizontal" Spacing="32">
                        <Image x:Name="LightSmall" Stretch="None" />
                        <Image x:Name="LightLarge" Stretch="None" />
                    </StackPanel>
                </Border>
                <Border Grid.Column="1" Height="150" Background="#202020" CornerRadius="4">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Orientation="Horizontal" Spacing="32">
                        <Image x:Name="DarkSmall" Stretch="None" />
                        <Image x:Name="DarkLarge" Stretch="None" />
                    </StackPanel>
                </Border>
                <StackPanel Grid.Column="2" VerticalAlignment="Center" Spacing="8">
                    <TextBlock
                        MaxWidth="180"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Text="{x:Bind loc:Text.Get('PointerPreview.Desc')}"
                        TextWrapping="Wrap" />
                    <Button Click="OnTestLocator" Content="{x:Bind loc:Text.Get('PointerTestLocator')}" Style="{StaticResource AccentButtonStyle}" />
                </StackPanel>
            </Grid>

            <TextBlock Style="{StaticResource GroupHeaderStyle}" Text="{x:Bind loc:Text.Get('PointerGroupSize')}" />
            <c:SettingCard Description="{x:Bind loc:Text.Get('PointerOverride.Desc')}" Glyph="&#xE771;" Header="{x:Bind loc:Text.Get('PointerOverride')}">
                <ToggleSwitch IsOn="{x:Bind Vm.OverrideWindows, Mode=TwoWay}" />
            </c:SettingCard>
            <c:SettingCard Description="{x:Bind loc:Text.Get('PointerUnzoomed.Desc')}" Glyph="&#xE8B0;" Header="{x:Bind loc:Text.Get('PointerUnzoomed')}">
                <c:ValueSlider Format="{}{0:0.00} ×" Maximum="4" Minimum="1" Step="0.25" Value="{x:Bind Vm.UnzoomedScale, Mode=TwoWay}" />
            </c:SettingCard>
            <c:SettingCard Description="{x:Bind loc:Text.Get('PointerGrow.Desc')}" Glyph="&#xE8A3;" Header="{x:Bind loc:Text.Get('PointerGrow')}">
                <ToggleSwitch IsOn="{x:Bind Vm.GrowWithZoom, Mode=TwoWay}" />
            </c:SettingCard>
            <c:SettingCard Description="{x:Bind loc:Text.Get('PointerMax.Desc')}" Glyph="&#xE71E;" Header="{x:Bind loc:Text.Get('PointerMax')}">
                <c:ValueSlider
                    Format="{}{0:0.0} ×"
                    IsEnabled="{x:Bind Vm.GrowWithZoom, Mode=OneWay}"
                    Maximum="8"
                    Minimum="1"
                    Step="0.5"
                    Value="{x:Bind Vm.MaxScale, Mode=TwoWay}" />
            </c:SettingCard>

            <TextBlock Style="{StaticResource GroupHeaderStyle}" Text="{x:Bind loc:Text.Get('PointerGroupColor')}" />
            <c:SettingCard Description="{x:Bind loc:Text.Get('PointerColorMode.Desc')}" Glyph="&#xE790;" Header="{x:Bind loc:Text.Get('PointerColorMode')}">
                <ComboBox MinWidth="200" SelectedIndex="{x:Bind Vm.ColorModeIndex, Mode=TwoWay}">
                    <ComboBoxItem Content="{x:Bind loc:Text.Get('PointerMode.Original')}" />
                    <ComboBoxItem Content="{x:Bind loc:Text.Get('PointerMode.Tint')}" />
                    <ComboBoxItem Content="{x:Bind loc:Text.Get('PointerMode.Inverted')}" />
                </ComboBox>
            </c:SettingCard>
            <c:SettingCard Glyph="&#xE2B1;" Header="{x:Bind loc:Text.Get('PointerColor')}">
                <c:ColorChooser Color="{x:Bind Vm.Color, Mode=TwoWay}" IsEnabled="{x:Bind Vm.UsesColor, Mode=OneWay}" />
            </c:SettingCard>
            <c:SettingCard Description="{x:Bind loc:Text.Get('PointerRim.Desc')}" Glyph="&#xE91F;" Header="{x:Bind loc:Text.Get('PointerRim')}">
                <ToggleSwitch IsOn="{x:Bind Vm.Rim, Mode=TwoWay}" />
            </c:SettingCard>
            <c:SettingCard Glyph="&#xE2B1;" Header="{x:Bind loc:Text.Get('PointerRimColor')}">
                <c:ColorChooser Color="{x:Bind Vm.RimColor, Mode=TwoWay}" IsEnabled="{x:Bind Vm.Rim, Mode=OneWay}" />
            </c:SettingCard>
            <c:SettingCard Glyph="&#xE7A8;" Header="{x:Bind loc:Text.Get('PointerRimWidth')}">
                <c:ValueSlider
                    Format="{}{0:0} px"
                    IsEnabled="{x:Bind Vm.Rim, Mode=OneWay}"
                    Maximum="8"
                    Minimum="1"
                    Step="1"
                    Value="{x:Bind Vm.RimWidth, Mode=TwoWay}" />
            </c:SettingCard>

            <TextBlock Style="{StaticResource GroupHeaderStyle}" Text="{x:Bind loc:Text.Get('PointerGroupLocator')}" />
            <c:SettingCard Description="{x:Bind loc:Text.Get('PointerTriggerHotkey.Desc')}" Glyph="&#xE765;" Header="{x:Bind loc:Text.Get('PointerTriggerHotkey')}">
                <ToggleSwitch IsOn="{x:Bind Vm.TriggerHotkey, Mode=TwoWay}" />
            </c:SettingCard>
            <c:SettingCard Description="{x:Bind loc:Text.Get('PointerTriggerShake.Desc')}" Glyph="&#xE962;" Header="{x:Bind loc:Text.Get('PointerTriggerShake')}">
                <ToggleSwitch IsOn="{x:Bind Vm.TriggerShake, Mode=TwoWay}" />
            </c:SettingCard>
            <c:SettingCard Description="{x:Bind loc:Text.Get('PointerTriggerIdle.Desc')}" Glyph="&#xE916;" Header="{x:Bind loc:Text.Get('PointerTriggerIdle')}">
                <ToggleSwitch IsOn="{x:Bind Vm.TriggerIdle, Mode=TwoWay}" />
            </c:SettingCard>
            <c:SettingCard Description="{x:Bind loc:Text.Get('PointerTriggerCtrl.Desc')}" Glyph="&#xE92E;" Header="{x:Bind loc:Text.Get('PointerTriggerCtrl')}">
                <ToggleSwitch IsOn="{x:Bind Vm.TriggerCtrl, Mode=TwoWay}" />
            </c:SettingCard>
            <c:SettingCard Glyph="&#xE2B1;" Header="{x:Bind loc:Text.Get('PointerLocatorColor')}">
                <c:ColorChooser Color="{x:Bind Vm.LocatorColor, Mode=TwoWay}" />
            </c:SettingCard>
            <c:SettingCard Glyph="&#xE740;" Header="{x:Bind loc:Text.Get('PointerLocatorSize')}">
                <c:ValueSlider Format="{}{0:0} px" Maximum="400" Minimum="60" Step="10" Value="{x:Bind Vm.LocatorSize, Mode=TwoWay}" />
            </c:SettingCard>
            <c:SettingCard Glyph="&#xE916;" Header="{x:Bind loc:Text.Get('PointerLocatorDuration')}">
                <c:ValueSlider Format="{}{0:0.0} s" Maximum="3" Minimum="0.3" Step="0.1" Value="{x:Bind Vm.LocatorSeconds, Mode=TwoWay}" />
            </c:SettingCard>

            <TextBlock Style="{StaticResource GroupHeaderStyle}" Text="{x:Bind loc:Text.Get('PointerGroupCrosshair')}" />
            <c:SettingCard Description="{x:Bind loc:Text.Get('PointerCrosshair.Desc')}" Glyph="&#xE710;" Header="{x:Bind loc:Text.Get('PointerCrosshair')}">
                <ComboBox MinWidth="200" SelectedIndex="{x:Bind Vm.CrosshairIndex, Mode=TwoWay}">
                    <ComboBoxItem Content="{x:Bind loc:Text.Get('Crosshair.Off')}" />
                    <ComboBoxItem Content="{x:Bind loc:Text.Get('Crosshair.Zoomed')}" />
                    <ComboBoxItem Content="{x:Bind loc:Text.Get('Crosshair.Always')}" />
                </ComboBox>
            </c:SettingCard>
            <c:SettingCard Description="{x:Bind loc:Text.Get('MarkerShow.Crosshair.Desc')}" Glyph="&#xE7B3;" Header="{x:Bind loc:Text.Get('MarkerShow')}">
                <ComboBox
                    MinWidth="200"
                    AutomationProperties.Name="{x:Bind loc:Text.Get('MarkerShow.Crosshair')}"
                    IsEnabled="{x:Bind Vm.CrosshairOn, Mode=OneWay}"
                    SelectedIndex="{x:Bind Vm.CrosshairShowIndex, Mode=TwoWay}">
                    <ComboBoxItem Content="{x:Bind loc:Text.Get('Show.Always')}" />
                    <ComboBoxItem Content="{x:Bind loc:Text.Get('Show.Idle')}" />
                    <ComboBoxItem Content="{x:Bind loc:Text.Get('Show.Moving')}" />
                    <ComboBoxItem Content="{x:Bind loc:Text.Get('Show.HoldKey')}" />
                </ComboBox>
            </c:SettingCard>
            <c:SettingCard Glyph="&#xE2B1;" Header="{x:Bind loc:Text.Get('PointerCrosshairColor')}">
                <c:ColorChooser Color="{x:Bind Vm.CrosshairColor, Mode=TwoWay}" IsEnabled="{x:Bind Vm.CrosshairOn, Mode=OneWay}" />
            </c:SettingCard>
            <c:SettingCard Glyph="&#xE7A8;" Header="{x:Bind loc:Text.Get('PointerCrosshairWidth')}">
                <c:ValueSlider
                    Format="{}{0:0} px"
                    IsEnabled="{x:Bind Vm.CrosshairOn, Mode=OneWay}"
                    Maximum="10"
                    Minimum="1"
                    Step="1"
                    Value="{x:Bind Vm.CrosshairWidth, Mode=TwoWay}" />
            </c:SettingCard>
            <c:SettingCard Glyph="&#xEF1F;" Header="{x:Bind loc:Text.Get('PointerCrosshairOpacity')}">
                <c:ValueSlider
                    Format="{}{0:0} %"
                    IsEnabled="{x:Bind Vm.CrosshairOn, Mode=OneWay}"
                    Maximum="100"
                    Minimum="20"
                    Step="5"
                    Value="{x:Bind Vm.CrosshairOpacity, Mode=TwoWay}" />
            </c:SettingCard>

            <!-- Mouse buffer and axis lock (A6): global settings, not part of "Reset" or the profile. -->
            <TextBlock Style="{StaticResource GroupHeaderStyle}" Text="{x:Bind loc:Text.Get('Constraint.Title')}" />
            <c:SettingCard Description="{x:Bind loc:Text.Get('Constraint.Buffer.Desc')}" Glyph="&#xE7F4;" Header="{x:Bind loc:Text.Get('Constraint.Buffer')}">
                <ComboBox MinWidth="200" SelectedIndex="{x:Bind Constraint.BufferIndex, Mode=TwoWay}">
                    <ComboBoxItem Content="{x:Bind loc:Text.Get('Constraint.Buffer.Off')}" />
                    <ComboBoxItem Content="{x:Bind loc:Text.Get('Constraint.Buffer.Light')}" />
                    <ComboBoxItem Content="{x:Bind loc:Text.Get('Constraint.Buffer.Medium')}" />
                    <ComboBoxItem Content="{x:Bind loc:Text.Get('Constraint.Buffer.Strong')}" />
                </ComboBox>
            </c:SettingCard>
            <c:SettingCard Description="{x:Bind loc:Text.Get('Constraint.Axis.Desc')}" Glyph="&#xE8AB;" Header="{x:Bind loc:Text.Get('Constraint.Axis')}">
                <ToggleSwitch IsOn="{x:Bind Constraint.AxisLock, Mode=TwoWay}" />
            </c:SettingCard>
            <c:SettingCard Description="{x:Bind loc:Text.Get('Constraint.Key.Desc')}" Glyph="&#xE765;" Header="{x:Bind loc:Text.Get('Constraint.Key')}">
                <ComboBox MinWidth="200" IsEnabled="{x:Bind Constraint.AxisLock, Mode=OneWay}" SelectedIndex="{x:Bind Constraint.KeyIndex, Mode=TwoWay}">
                    <ComboBoxItem Content="{x:Bind loc:Text.Get('Constraint.Key.LeftShift')}" />
                    <ComboBoxItem Content="{x:Bind loc:Text.Get('Constraint.Key.RightShift')}" />
                    <ComboBoxItem Content="{x:Bind loc:Text.Get('Constraint.Key.LeftControl')}" />
                    <ComboBoxItem Content="{x:Bind loc:Text.Get('Constraint.Key.RightControl')}" />
                    <ComboBoxItem Content="{x:Bind loc:Text.Get('Constraint.Key.LeftAlt')}" />
                    <ComboBoxItem Content="{x:Bind loc:Text.Get('Constraint.Key.RightAlt')}" />
                </ComboBox>
            </c:SettingCard>

            <TextBlock Style="{StaticResource GroupHeaderStyle}" Text="{x:Bind loc:Text.Get('PointerGroupMore')}" />
            <c:SettingCard Description="{x:Bind loc:Text.Get('PointerHideTyping.Desc')}" Glyph="&#xE765;" Header="{x:Bind loc:Text.Get('PointerHideTyping')}">
                <ToggleSwitch IsOn="{x:Bind Vm.HideWhileTyping, Mode=TwoWay}" />
            </c:SettingCard>
            <c:SettingCard Glyph="&#xE777;" Header="{x:Bind loc:Text.Get('PointerReset')}">
                <Button Click="OnReset" Content="{x:Bind loc:Text.Get('Reset')}" />
            </c:SettingCard>
        </StackPanel>
    </ScrollViewer>
</Page>
