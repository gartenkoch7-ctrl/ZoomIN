<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="ZoomIN.App.Views.Pages.WelcomePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:loc="using:ZoomIN.App.Localization">

    <StackPanel MaxWidth="640" HorizontalAlignment="Left" Spacing="20">
        <TextBlock Style="{StaticResource TitleLargeTextBlockStyle}" Text="{x:Bind loc:Text.WelcomeTitle}" />
        <TextBlock Style="{StaticResource CaptionTextBlockStyle}" Text="{x:Bind Vm.Progress, Mode=OneWay}" />

        <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="{x:Bind Vm.StepTitle, Mode=OneWay}" />
        <TextBlock FontSize="18" Text="{x:Bind Vm.StepText, Mode=OneWay}" TextWrapping="Wrap" />

        <Button Click="OnToggleFilter" Content="{x:Bind loc:Text.ColorsFilterOn}" Visibility="{x:Bind Vm.ShowsFilterToggle, Mode=OneWay}" />
        <ToggleSwitch Header="{x:Bind loc:Text.GeneralAutostart}" IsOn="{x:Bind Vm.Autostart, Mode=TwoWay}" Visibility="{x:Bind Vm.ShowsAutostart, Mode=OneWay}" />
        <ToggleSwitch Header="{x:Bind loc:Text.GeneralUpdates}" IsOn="{x:Bind Vm.CheckUpdates, Mode=TwoWay}" Visibility="{x:Bind Vm.ShowsUpdates, Mode=OneWay}" />

        <StackPanel Orientation="Horizontal" Spacing="8">
            <Button Click="OnBack" Content="{x:Bind loc:Text.WelcomeBack}" IsEnabled="{x:Bind Vm.CanGoBack, Mode=OneWay}" />
            <Button Click="OnNext" Content="{x:Bind Vm.NextText, Mode=OneWay}" Style="{StaticResource AccentButtonStyle}" />
        </StackPanel>
    </StackPanel>
</Page>
