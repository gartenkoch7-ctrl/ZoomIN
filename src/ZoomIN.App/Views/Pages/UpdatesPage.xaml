<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="ZoomIN.App.Views.Pages.UpdatesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:c="using:ZoomIN.App.Views.Controls"
    xmlns:loc="using:ZoomIN.App.Localization">

    <ScrollViewer>
        <StackPanel MaxWidth="{StaticResource PageMaxWidth}" Style="{StaticResource CardStackStyle}">
            <TextBlock Style="{StaticResource PageTitleStyle}" Text="{x:Bind loc:Text.Get('NavUpdates')}" />

            <InfoBar IsClosable="False" IsOpen="{x:Bind Vm.NotInstallable}" Message="{x:Bind loc:Text.Get('Updates.NotInstalled')}" Severity="Informational" />

            <c:SettingCard Glyph="&#xE946;" Header="{x:Bind loc:Text.Get('Updates.Installed')}">
                <TextBlock FontWeight="SemiBold" IsTextSelectionEnabled="True" Text="{x:Bind Vm.Installed}" />
            </c:SettingCard>
            <c:SettingCard Description="{x:Bind loc:Text.Get('Updates.Channel.Desc')}" Glyph="&#xE8AB;" Header="{x:Bind loc:Text.Get('Updates.Channel')}">
                <ComboBox
                    MinWidth="200"
                    AutomationProperties.Name="{x:Bind loc:Text.Get('Updates.Channel')}"
                    IsEnabled="{x:Bind Vm.IsIdle, Mode=OneWay}"
                    SelectedIndex="{x:Bind Vm.ChannelIndex, Mode=TwoWay}">
                    <ComboBoxItem Content="{x:Bind loc:Text.Get('Updates.Stable')}" />
                    <ComboBoxItem Content="{x:Bind loc:Text.Get('Updates.Experimental')}" />
                </ComboBox>
            </c:SettingCard>
            <c:SettingCard Description="{x:Bind loc:Text.GeneralUpdatesHint}" Glyph="&#xE895;" Header="{x:Bind loc:Text.GeneralUpdates}">
                <ToggleSwitch AutomationProperties.Name="{x:Bind loc:Text.GeneralUpdates}" IsOn="{x:Bind Vm.CheckUpdates, Mode=TwoWay}" />
            </c:SettingCard>

            <TextBlock Style="{StaticResource GroupHeaderStyle}" Text="{x:Bind loc:Text.Get('Updates.Versions')}" />
            <Border
                Padding="8"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="{StaticResource OverlayCornerRadius}">
                <StackPanel Spacing="8">
                    <!-- Polite live region: screen readers announce search, download and result. -->
                    <TextBlock
                        x:Name="StatusText"
                        Margin="8,4,8,0"
                        AutomationProperties.LiveSetting="Polite"
                        Text="{x:Bind Vm.Status, Mode=OneWay}"
                        TextWrapping="Wrap" />
                    <ProgressBar
                        Margin="8,0"
                        AutomationProperties.Name="{x:Bind Vm.Status, Mode=OneWay}"
                        Maximum="100"
                        Visibility="{x:Bind Vm.IsBusy, Mode=OneWay}"
                        Value="{x:Bind Vm.Progress, Mode=OneWay}" />
                    <ListView
                        MinHeight="120"
                        MaxHeight="300"
                        AutomationProperties.Name="{x:Bind loc:Text.Get('Updates.Versions')}"
                        IsEnabled="{x:Bind Vm.IsIdle, Mode=OneWay}"
                        ItemsSource="{x:Bind Vm.Versions}"
                        SelectedIndex="{x:Bind Vm.SelectedIndex, Mode=TwoWay}" />
                    <TextBlock
                        Margin="8,0"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text="{x:Bind loc:Text.Get('Updates.DowngradeHint')}"
                        TextWrapping="Wrap"
                        Visibility="{x:Bind Vm.IsDowngrade, Mode=OneWay}" />
                    <StackPanel Margin="8,0,8,8" Orientation="Horizontal" Spacing="8">
                        <Button
                            Click="OnInstall"
                            Content="{x:Bind Vm.InstallText, Mode=OneWay}"
                            IsEnabled="{x:Bind Vm.CanInstallSelected, Mode=OneWay}"
                            Style="{StaticResource AccentButtonStyle}" />
                        <Button Click="OnRefresh" Content="{x:Bind loc:Text.Get('Updates.Refresh')}" IsEnabled="{x:Bind Vm.IsIdle, Mode=OneWay}" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
