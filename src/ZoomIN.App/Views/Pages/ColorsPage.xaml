<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="ZoomIN.App.Views.Pages.ColorsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:loc="using:ZoomIN.App.Localization">

    <ScrollViewer>
        <StackPanel MaxWidth="680" HorizontalAlignment="Left" Spacing="20">
            <TextBlock Style="{StaticResource TitleTextBlockStyle}" Text="{x:Bind loc:Text.NavColors}" />

            <ToggleSwitch Header="{x:Bind loc:Text.ColorsFilterOn}" IsOn="{x:Bind Vm.FilterOn, Mode=TwoWay}" />
            <ComboBox
                MinWidth="280"
                Header="{x:Bind loc:Text.ColorsFilter}"
                ItemsSource="{x:Bind Vm.FilterNames}"
                SelectedIndex="{x:Bind Vm.FilterIndex, Mode=TwoWay}" />

            <Slider
                Header="{x:Bind loc:Text.ColorsContrast}"
                Maximum="300"
                Minimum="50"
                StepFrequency="5"
                Value="{x:Bind Vm.Contrast, Mode=TwoWay}" />
            <Slider
                Header="{x:Bind loc:Text.ColorsBrightness}"
                Maximum="50"
                Minimum="-50"
                StepFrequency="5"
                Value="{x:Bind Vm.Brightness, Mode=TwoWay}" />

            <Slider
                Header="{x:Bind loc:Text.ColorsCursorSize}"
                Maximum="8"
                Minimum="1"
                StepFrequency="0.5"
                Value="{x:Bind Vm.CursorMax, Mode=TwoWay}" />
            <ToggleSwitch Header="{x:Bind loc:Text.ColorsCursorRim}" IsOn="{x:Bind Vm.Rim, Mode=TwoWay}" />
            <ToggleSwitch Header="{x:Bind loc:Text.ColorsAutoLocate}" IsOn="{x:Bind Vm.AutoLocate, Mode=TwoWay}" />
        </StackPanel>
    </ScrollViewer>
</Page>
