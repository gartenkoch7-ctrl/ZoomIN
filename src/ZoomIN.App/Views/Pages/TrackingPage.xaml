<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="ZoomIN.App.Views.Pages.TrackingPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:c="using:ZoomIN.App.Views.Controls"
    xmlns:loc="using:ZoomIN.App.Localization">

    <ScrollViewer>
        <StackPanel MaxWidth="{StaticResource PageMaxWidth}" Style="{StaticResource CardStackStyle}">
            <TextBlock Style="{StaticResource PageTitleStyle}" Text="{x:Bind loc:Text.NavTracking}" />

            <c:SettingCard Description="{x:Bind loc:Text.Get('Overview.Tracking.Desc')}" Glyph="&#xE8D2;" Header="{x:Bind loc:Text.TrackingOn}">
                <ToggleSwitch IsOn="{x:Bind Vm.TrackingEnabled, Mode=TwoWay}" />
            </c:SettingCard>
            <c:SettingCard Description="{x:Bind loc:Text.Get('TrackingFocus.Desc')}" Glyph="&#xE7C9;" Header="{x:Bind loc:Text.TrackingFocus}">
                <ToggleSwitch IsOn="{x:Bind Vm.Focus, Mode=TwoWay}" />
            </c:SettingCard>
            <c:SettingCard Description="{x:Bind loc:Text.Get('TrackingCaret.Desc')}" Glyph="&#xE8AC;" Header="{x:Bind loc:Text.TrackingCaret}">
                <ToggleSwitch IsOn="{x:Bind Vm.Caret, Mode=TwoWay}" />
            </c:SettingCard>

            <TextBlock Style="{StaticResource GroupHeaderStyle}" Text="{x:Bind loc:Text.Get('TrackingGroupMotion')}" />
            <c:SettingCard Description="{x:Bind loc:Text.Get('TrackingCenterMouse.Desc')}" Glyph="&#xE962;" Header="{x:Bind loc:Text.TrackingCenterMouse}">
                <ToggleSwitch IsOn="{x:Bind Vm.CenterMouse, Mode=TwoWay}" />
            </c:SettingCard>
            <c:SettingCard Description="{x:Bind loc:Text.Get('TrackingPan.Desc')}" Glyph="&#xE916;" Header="{x:Bind loc:Text.Get('TrackingPanTitle')}">
                <c:ValueSlider Format="{}{0:0} ms" Maximum="1000" Minimum="0" Step="50" Value="{x:Bind Vm.PanMs, Mode=TwoWay}" />
            </c:SettingCard>
            <c:SettingCard Description="{x:Bind loc:Text.Get('TrackingMargin.Desc')}" Glyph="&#xE740;" Header="{x:Bind loc:Text.Get('TrackingMarginTitle')}">
                <c:ValueSlider Format="{}{0:0} %" Maximum="40" Minimum="0" Step="5" Value="{x:Bind Vm.Margin, Mode=TwoWay}" />
            </c:SettingCard>

            <TextBlock Style="{StaticResource GroupHeaderStyle}" Text="{x:Bind loc:Text.Get('TrackingGroupMarks')}" />
            <c:SettingCard Description="{x:Bind loc:Text.Get('TrackingFocusFrame.Desc')}" Glyph="&#xE91F;" Header="{x:Bind loc:Text.TrackingFocusFrame}">
                <ToggleSwitch IsOn="{x:Bind Vm.FocusFrame, Mode=TwoWay}" />
            </c:SettingCard>
            <c:SettingCard Description="{x:Bind loc:Text.Get('MarkerShow.Desc')}" Glyph="&#xE7B3;" Header="{x:Bind loc:Text.Get('MarkerShow.FocusFrame')}">
                <ComboBox
                    MinWidth="200"
                    AutomationProperties.Name="{x:Bind loc:Text.Get('MarkerShow.FocusFrame')}"
                    IsEnabled="{x:Bind Vm.FocusFrame, Mode=OneWay}"
                    SelectedIndex="{x:Bind Vm.FocusFrameShowIndex, Mode=TwoWay}">
                    <ComboBoxItem Content="{x:Bind loc:Text.Get('Show.Always')}" />
                    <ComboBoxItem Content="{x:Bind loc:Text.Get('Show.Idle')}" />
                    <ComboBoxItem Content="{x:Bind loc:Text.Get('Show.Moving')}" />
                    <ComboBoxItem Content="{x:Bind loc:Text.Get('Show.HoldKey')}" />
                </ComboBox>
            </c:SettingCard>
            <c:SettingCard Description="{x:Bind loc:Text.Get('TrackingCaretMarker.Desc')}" Glyph="&#xE8AC;" Header="{x:Bind loc:Text.TrackingCaretMarker}">
                <ToggleSwitch IsOn="{x:Bind Vm.CaretMarker, Mode=TwoWay}" />
            </c:SettingCard>
            <c:SettingCard Description="{x:Bind loc:Text.Get('MarkerShow.Desc')}" Glyph="&#xE7B3;" Header="{x:Bind loc:Text.Get('MarkerShow.Caret')}">
                <ComboBox
                    MinWidth="200"
                    AutomationProperties.Name="{x:Bind loc:Text.Get('MarkerShow.Caret')}"
                    IsEnabled="{x:Bind Vm.CaretMarker, Mode=OneWay}"
                    SelectedIndex="{x:Bind Vm.CaretShowIndex, Mode=TwoWay}">
                    <ComboBoxItem Content="{x:Bind loc:Text.Get('Show.Always')}" />
                    <ComboBoxItem Content="{x:Bind loc:Text.Get('Show.Idle')}" />
                    <ComboBoxItem Content="{x:Bind loc:Text.Get('Show.Moving')}" />
                    <ComboBoxItem Content="{x:Bind loc:Text.Get('Show.HoldKey')}" />
                </ComboBox>
            </c:SettingCard>

            <!-- E2: caret marker look with a small preview; the preview's name describes it for screen readers. -->
            <TextBlock Style="{StaticResource GroupHeaderStyle}" Text="{x:Bind loc:Text.Get('CaretMarker.Group')}" />
            <Border
                Padding="16"
                HorizontalAlignment="Stretch"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="{StaticResource OverlayCornerRadius}">
                <StackPanel Spacing="8">
                    <!-- Decorative sample text: screen readers get the description below instead. -->
                    <StackPanel
                        Height="110"
                        HorizontalAlignment="Center"
                        AutomationProperties.AccessibilityView="Raw"
                        Orientation="Horizontal">
                        <TextBlock VerticalAlignment="Center" AutomationProperties.AccessibilityView="Raw" FontSize="32" Text="Ab" />
                        <!-- Above both sample words, like the marker above the text in the magnified view. -->
                        <Grid
                            Canvas.ZIndex="1"
                            Width="2"
                            Height="40"
                            Margin="4,0"
                            VerticalAlignment="Center">
                            <Rectangle Fill="{ThemeResource TextFillColorPrimaryBrush}" />
                            <Canvas x:Name="CaretCanvas" />
                        </Grid>
                        <TextBlock VerticalAlignment="Center" AutomationProperties.AccessibilityView="Raw" FontSize="32" Text="cd" />
                    </StackPanel>
                    <TextBlock
                        x:Name="CaretPreviewText"
                        HorizontalAlignment="Center"
                        AutomationProperties.LiveSetting="Polite"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Text="{x:Bind Vm.CaretDescription, Mode=OneWay}"
                        TextWrapping="Wrap" />
                </StackPanel>
            </Border>
            <c:SettingCard Description="{x:Bind loc:Text.Get('CaretMarker.Shape.Desc')}" Glyph="&#xE8AC;" Header="{x:Bind loc:Text.Get('CaretMarker.Shape')}">
                <ComboBox
                    MinWidth="200"
                    AutomationProperties.Name="{x:Bind loc:Text.Get('CaretMarker.Shape')}"
                    IsEnabled="{x:Bind Vm.CaretMarker, Mode=OneWay}"
                    SelectedIndex="{x:Bind Vm.CaretShapeIndex, Mode=TwoWay}">
                    <ComboBoxItem Content="{x:Bind loc:Text.Get('CaretShape.Bar')}" />
                    <ComboBoxItem Content="{x:Bind loc:Text.Get('CaretShape.Wedges')}" />
                    <ComboBoxItem Content="{x:Bind loc:Text.Get('CaretShape.Frame')}" />
                    <ComboBoxItem Content="{x:Bind loc:Text.Get('CaretShape.Circle')}" />
                </ComboBox>
            </c:SettingCard>
            <c:SettingCard Glyph="&#xE2B1;" Header="{x:Bind loc:Text.Get('CaretMarker.Color')}">
                <c:ColorChooser Color="{x:Bind Vm.CaretColor, Mode=TwoWay}" IsEnabled="{x:Bind Vm.CaretMarker, Mode=OneWay}" />
            </c:SettingCard>
            <c:SettingCard Description="{x:Bind loc:Text.Get('CaretMarker.Thickness.Desc')}" Glyph="&#xE7A8;" Header="{x:Bind loc:Text.Get('CaretMarker.Thickness')}">
                <ComboBox
                    MinWidth="200"
                    AutomationProperties.Name="{x:Bind loc:Text.Get('CaretMarker.Thickness')}"
                    IsEnabled="{x:Bind Vm.CaretMarker, Mode=OneWay}"
                    SelectedIndex="{x:Bind Vm.CaretThicknessIndex, Mode=TwoWay}">
                    <ComboBoxItem Content="{x:Bind loc:Text.Get('CaretThickness.Thin')}" />
                    <ComboBoxItem Content="{x:Bind loc:Text.Get('CaretThickness.Medium')}" />
                    <ComboBoxItem Content="{x:Bind loc:Text.Get('CaretThickness.Thick')}" />
                </ComboBox>
            </c:SettingCard>
        </StackPanel>
    </ScrollViewer>
</Page>
