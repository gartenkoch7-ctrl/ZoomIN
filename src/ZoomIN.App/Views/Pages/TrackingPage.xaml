<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="ZoomIN.App.Views.Pages.TrackingPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:loc="using:ZoomIN.App.Localization">

    <ScrollViewer>
        <StackPanel MaxWidth="680" HorizontalAlignment="Left" Spacing="20">
            <TextBlock Style="{StaticResource TitleTextBlockStyle}" Text="{x:Bind loc:Text.NavTracking}" />

            <ToggleSwitch Header="{x:Bind loc:Text.TrackingOn}" IsOn="{x:Bind Vm.TrackingEnabled, Mode=TwoWay}" />
            <ToggleSwitch Header="{x:Bind loc:Text.TrackingFocus}" IsOn="{x:Bind Vm.Focus, Mode=TwoWay}" />
            <ToggleSwitch Header="{x:Bind loc:Text.TrackingCaret}" IsOn="{x:Bind Vm.Caret, Mode=TwoWay}" />

            <Slider
                Header="{x:Bind loc:Text.TrackingPan}"
                Maximum="1000"
                Minimum="0"
                StepFrequency="50"
                Value="{x:Bind Vm.PanMs, Mode=TwoWay}" />
            <Slider
                Header="{x:Bind loc:Text.TrackingMargin}"
                Maximum="40"
                Minimum="0"
                StepFrequency="5"
                Value="{x:Bind Vm.Margin, Mode=TwoWay}" />

            <ToggleSwitch Header="{x:Bind loc:Text.TrackingFocusFrame}" IsOn="{x:Bind Vm.FocusFrame, Mode=TwoWay}" />
            <ToggleSwitch Header="{x:Bind loc:Text.TrackingCaretMarker}" IsOn="{x:Bind Vm.CaretMarker, Mode=TwoWay}" />
        </StackPanel>
    </ScrollViewer>
</Page>
