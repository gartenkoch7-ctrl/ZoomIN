<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="ZoomIN.App.Views.Pages.HotkeysPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:loc="using:ZoomIN.App.Localization"
    xmlns:vm="using:ZoomIN.App.ViewModels"
    PreviewKeyDown="OnPreviewKeyDown">

    <ScrollViewer>
        <StackPanel MaxWidth="760" HorizontalAlignment="Left" Spacing="16">
            <TextBlock Style="{StaticResource TitleTextBlockStyle}" Text="{x:Bind loc:Text.NavHotkeys}" />
            <TextBlock Text="{x:Bind loc:Text.HotkeysIntro}" TextWrapping="Wrap" />
            <InfoBar IsClosable="False" IsOpen="{x:Bind HasMessage}" Message="{x:Bind Vm.Message, Mode=OneWay}" Severity="Warning" />

            <ItemsControl ItemsSource="{x:Bind Vm.Rows}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:HotkeyRow">
                        <Grid Padding="0,6" ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="260" />
                                <ColumnDefinition Width="220" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock VerticalAlignment="Center" Text="{x:Bind Name}" />
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock FontWeight="SemiBold" Text="{x:Bind Gesture, Mode=OneWay}" />
                                <TextBlock Foreground="{ThemeResource SystemFillColorCautionBrush}" Style="{StaticResource CaptionTextBlockStyle}" Text="{x:Bind Warning, Mode=OneWay}" />
                            </StackPanel>
                            <Button
                                Grid.Column="2"
                                AutomationProperties.Name="{x:Bind Name}"
                                Click="OnChangeClick"
                                Content="{x:Bind loc:Text.HotkeyChange}" />
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </ScrollViewer>
</Page>
