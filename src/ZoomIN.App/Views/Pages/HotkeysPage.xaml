<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="ZoomIN.App.Views.Pages.HotkeysPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:c="using:ZoomIN.App.Views.Controls"
    xmlns:loc="using:ZoomIN.App.Localization"
    xmlns:vm="using:ZoomIN.App.ViewModels"
    PreviewKeyDown="OnPreviewKeyDown">

    <ScrollViewer>
        <StackPanel MaxWidth="{StaticResource PageMaxWidth}" Style="{StaticResource CardStackStyle}">
            <TextBlock Style="{StaticResource PageTitleStyle}" Text="{x:Bind loc:Text.NavHotkeys}" />
            <TextBlock Margin="0,0,0,8" Text="{x:Bind loc:Text.HotkeysIntro}" TextWrapping="Wrap" />
            <InfoBar IsClosable="False" IsOpen="{x:Bind HasMessage}" Message="{x:Bind Vm.Message, Mode=OneWay}" Severity="Warning" />

            <ItemsControl ItemsSource="{x:Bind Vm.Rows}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Spacing="4" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:HotkeyRow">
                        <c:SettingCard Description="{x:Bind Description, Mode=OneWay}" Glyph="&#xE765;" Header="{x:Bind Name}">
                            <StackPanel Orientation="Horizontal" Spacing="16">
                                <Border
                                    MinWidth="140"
                                    Padding="10,4"
                                    VerticalAlignment="Center"
                                    Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                    CornerRadius="4">
                                    <TextBlock
                                        HorizontalAlignment="Center"
                                        FontWeight="SemiBold"
                                        Text="{x:Bind Gesture, Mode=OneWay}" />
                                </Border>
                                <Button
                                    AutomationProperties.Name="{x:Bind Name}"
                                    Click="OnChangeClick"
                                    Content="{x:Bind loc:Text.HotkeyChange}" />
                            </StackPanel>
                        </c:SettingCard>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- E1: the hold key for highlights set to "only while the key is held". -->
            <TextBlock Style="{StaticResource GroupHeaderStyle}" Text="{x:Bind loc:Text.Get('HoldKey.Group')}" />
            <c:SettingCard Description="{x:Bind loc:Text.Get('HoldKey.Desc')}" Glyph="&#xE7B3;" Header="{x:Bind loc:Text.Get('HoldKey')}">
                <ComboBox
                    MinWidth="200"
                    AutomationProperties.Name="{x:Bind loc:Text.Get('HoldKey')}"
                    SelectedIndex="{x:Bind Vm.HoldKeyIndex, Mode=TwoWay}">
                    <ComboBoxItem Content="{x:Bind loc:Text.Get('HoldKey.RightShift')}" />
                    <ComboBoxItem Content="{x:Bind loc:Text.Get('HoldKey.LeftShift')}" />
                    <ComboBoxItem Content="{x:Bind loc:Text.Get('HoldKey.RightCtrl')}" />
                    <ComboBoxItem Content="{x:Bind loc:Text.Get('HoldKey.LeftCtrl')}" />
                    <ComboBoxItem Content="{x:Bind loc:Text.Get('HoldKey.RightAlt')}" />
                    <ComboBoxItem Content="{x:Bind loc:Text.Get('HoldKey.LeftAlt')}" />
                </ComboBox>
            </c:SettingCard>
        </StackPanel>
    </ScrollViewer>
</Page>
