<?xml version="1.0" encoding="utf-8"?>
<!--
  Installer build only (ADR-0012, scripts/publish.ps1 -UiAccess): same as app.manifest plus
  uiAccess="true". Windows then puts ZoomIN's topmost overlay in the UIAccess z-band, above shell
  flyouts (quick settings, notification center, Start). Windows starts such an exe only when it is
  Authenticode-signed with a trusted certificate and installed in a protected folder
  (Program Files); everywhere else it refuses to start - so dev builds and the ZIP keep app.manifest.
-->
<assembly manifestVersion="1.0" xmlns="urn:schemas-microsoft-com:asm.v1">
  <assemblyIdentity version="1.0.0.0" name="ZoomIN.app" />

  <trustInfo xmlns="urn:schemas-microsoft-com:asm.v3">
    <security>
      <requestedPrivileges>
        <requestedExecutionLevel level="asInvoker" uiAccess="true" />
      </requestedPrivileges>
    </security>
  </trustInfo>

  <compatibility xmlns="urn:schemas-microsoft-com:compatibility.v1">
    <application>
      <!-- Windows 10 and 11 -->
      <supportedOS Id="{8e0f7a12-bfb3-4fe8-b9a5-48fd50a15a9a}" />
    </application>
  </compatibility>

  <application xmlns="urn:schemas-microsoft-com:asm.v3">
    <windowsSettings>
      <!-- Per-monitor DPI v2 is mandatory (AGENTS.md 2.4): all coordinates are physical pixels. -->
      <dpiAwareness xmlns="http://schemas.microsoft.com/SMI/2016/WindowsSettings">PerMonitorV2</dpiAwareness>
      <longPathAware xmlns="http://schemas.microsoft.com/SMI/2016/WindowsSettings">true</longPathAware>
    </windowsSettings>
  </application>
</assembly>
