<Project Sdk="Microsoft.NET.Sdk">
  <!-- D3D11, Desktop Duplication, shaders, overlay swapchain, render thread. References Core only. -->
  <PropertyGroup>
    <TargetFramework>$(ZoomInWindowsTfm)</TargetFramework>
    <SupportedOSPlatformVersion>$(ZoomInMinWindows)</SupportedOSPlatformVersion>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\ZoomIN.Core\ZoomIN.Core.csproj" />
    <InternalsVisibleTo Include="ZoomIN.Rendering.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Vortice.Direct3D11" />
    <!-- Direct, so the [LoggerMessage] source generator runs here too (ADR-0019). -->
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
    <PackageReference Include="Vortice.DXGI" />
    <PackageReference Include="Vortice.D3DCompiler" />
    <PackageReference Include="Vortice.DirectComposition" />
    <PackageReference Include="Microsoft.Windows.CsWin32" PrivateAssets="all" />
  </ItemGroup>

  <!-- Shaders are compiled at startup from embedded sources (docs/kb/rendering-pipeline.md). -->
  <ItemGroup>
    <EmbeddedResource Include="Shaders\*.hlsl" LogicalName="ZoomIN.Shaders.%(Filename)%(Extension)" />
  </ItemGroup>
</Project>
