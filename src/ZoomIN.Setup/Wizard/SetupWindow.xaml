<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="ZoomIN.Setup.Wizard.SetupWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:ZoomIN.Setup.Wizard"
    xmlns:loc="using:ZoomIN.Setup.Localization"
    Title="ZoomIN">

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid x:Name="Root" RowDefinitions="Auto,*,Auto">
        <Grid.KeyboardAccelerators>
            <KeyboardAccelerator Invoked="OnZoomIn" Key="Add" Modifiers="Control" />
            <KeyboardAccelerator Invoked="OnZoomOut" Key="Subtract" Modifiers="Control" />
            <KeyboardAccelerator Invoked="OnZoomReset" Key="Number0" Modifiers="Control" />
        </Grid.KeyboardAccelerators>

        <!-- Header: progress and the setup's own magnification (no magnifier runs yet). -->
        <Grid Padding="24,16,24,8" ColumnDefinitions="*,Auto">
            <TextBlock VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{x:Bind Vm.ProgressText, Mode=OneWay}" />
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                <Button Click="OnZoomOut" Content="{x:Bind loc:SetupText.Get('Zoom.Out')}" ToolTipService.ToolTip="{x:Bind loc:SetupText.Get('Zoom.Hint')}" />
                <Button Click="OnZoomIn" Content="{x:Bind loc:SetupText.Get('Zoom.In')}" ToolTipService.ToolTip="{x:Bind loc:SetupText.Get('Zoom.Hint')}" />
            </StackPanel>
        </Grid>

        <ScrollViewer
            x:Name="Zoomer"
            Grid.Row="1"
            HorizontalScrollBarVisibility="Auto"
            HorizontalScrollMode="Auto"
            MaxZoomFactor="4"
            MinZoomFactor="1"
            ZoomMode="Enabled">
            <StackPanel MaxWidth="640" Padding="24,8,24,24" HorizontalAlignment="Left">
                <TextBlock
                    x:Name="StepTitleText"
                    AutomationProperties.HeadingLevel="Level1"
                    AutomationProperties.LiveSetting="Assertive"
                    Style="{StaticResource StepTitleStyle}"
                    Text="{x:Bind Vm.StepTitle, Mode=OneWay}" />
                <TextBlock Style="{StaticResource StepTextStyle}" Text="{x:Bind Vm.StepText, Mode=OneWay}" />

                <!-- 0: language -->
                <ComboBox
                    MinWidth="240"
                    Header="{x:Bind loc:SetupText.Get('Language')}"
                    SelectedIndex="{x:Bind Vm.LanguageIndex, Mode=TwoWay}"
                    Visibility="{x:Bind local:SetupWindow.On(Vm.Step, 0), Mode=OneWay}">
                    <ComboBoxItem Content="Deutsch" />
                    <ComboBoxItem Content="English" />
                </ComboBox>

                <!-- 1: channel and version -->
                <StackPanel Spacing="12" Visibility="{x:Bind local:SetupWindow.On(Vm.Step, 1), Mode=OneWay}">
                    <ComboBox
                        MinWidth="240"
                        Header="{x:Bind loc:SetupText.Get('Channel')}"
                        IsEnabled="{x:Bind local:SetupWindow.Not(Vm.IsBusy), Mode=OneWay}"
                        SelectedIndex="{x:Bind Vm.ChannelIndex, Mode=TwoWay}">
                        <ComboBoxItem Content="{x:Bind loc:SetupText.Get('Stable')}" />
                        <ComboBoxItem Content="{x:Bind loc:SetupText.Get('Experimental')}" />
                    </ComboBox>
                    <ListView
                        MinHeight="120"
                        MaxHeight="260"
                        AutomationProperties.Name="{x:Bind loc:SetupText.Get('Versions')}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="4"
                        ItemsSource="{x:Bind Vm.Versions}"
                        SelectedIndex="{x:Bind Vm.SelectedIndex, Mode=TwoWay}" />
                    <Button Click="OnRefresh" Content="{x:Bind loc:SetupText.Get('Refresh')}" IsEnabled="{x:Bind local:SetupWindow.Not(Vm.IsBusy), Mode=OneWay}" />
                </StackPanel>

                <!-- 2: settings -->
                <StackPanel Spacing="12" Visibility="{x:Bind local:SetupWindow.On(Vm.Step, 2), Mode=OneWay}">
                    <CheckBox Content="{x:Bind loc:SetupText.Get('Autostart')}" IsChecked="{x:Bind Vm.Autostart, Mode=TwoWay}" />
                    <CheckBox Content="{x:Bind loc:SetupText.Get('Desktop')}" IsChecked="{x:Bind Vm.DesktopShortcut, Mode=TwoWay}" />
                    <CheckBox Content="{x:Bind loc:SetupText.Get('SecureDesktop')}" IsChecked="{x:Bind Vm.SecureDesktop, Mode=TwoWay}" />
                    <StackPanel>
                        <CheckBox Content="{x:Bind loc:SetupText.Get('Updates')}" IsChecked="{x:Bind Vm.CheckForUpdates, Mode=TwoWay}" />
                        <TextBlock Margin="28,0,0,0" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{x:Bind loc:SetupText.Get('Updates.Desc')}" TextWrapping="Wrap" />
                    </StackPanel>
                    <Slider
                        MaxWidth="360"
                        HorizontalAlignment="Left"
                        Header="{x:Bind loc:SetupText.Get('ZoomLevel')}"
                        Maximum="8"
                        Minimum="1.5"
                        StepFrequency="0.5"
                        TickFrequency="0.5"
                        Value="{x:Bind Vm.ZoomLevel, Mode=TwoWay}" />
                    <ComboBox MinWidth="240" Header="{x:Bind loc:SetupText.Get('Filter')}" SelectedIndex="{x:Bind Vm.FilterIndex, Mode=TwoWay}">
                        <ComboBoxItem Content="{x:Bind loc:SetupText.Get('Filter.Off')}" />
                        <ComboBoxItem Content="{x:Bind loc:SetupText.Get('Filter.Inverted')}" />
                        <ComboBoxItem Content="{x:Bind loc:SetupText.Get('Filter.Grayscale')}" />
                        <ComboBoxItem Content="{x:Bind loc:SetupText.Get('Filter.YellowOnBlack')}" />
                        <ComboBoxItem Content="{x:Bind loc:SetupText.Get('Filter.BlackOnYellow')}" />
                        <ComboBoxItem Content="{x:Bind loc:SetupText.Get('Filter.WhiteOnBlue')}" />
                    </ComboBox>
                </StackPanel>

                <!-- 3: install progress (status is shared with step 1) -->
                <ProgressBar
                    Margin="0,0,0,12"
                    AutomationProperties.Name="{x:Bind Vm.Status, Mode=OneWay}"
                    Maximum="100"
                    Visibility="{x:Bind local:SetupWindow.On(Vm.Step, 3), Mode=OneWay}"
                    Value="{x:Bind Vm.Progress, Mode=OneWay}" />

                <!-- 4: done -->
                <CheckBox Content="{x:Bind loc:SetupText.Get('StartNow')}" IsChecked="{x:Bind Vm.StartNow, Mode=TwoWay}" Visibility="{x:Bind local:SetupWindow.On(Vm.Step, 4), Mode=OneWay}" />

                <TextBlock
                    x:Name="StatusText"
                    Margin="0,12,0,0"
                    AutomationProperties.LiveSetting="Polite"
                    Text="{x:Bind Vm.Status, Mode=OneWay}"
                    TextWrapping="Wrap"
                    Visibility="{x:Bind local:SetupWindow.OnStatusStep(Vm.Step), Mode=OneWay}" />
            </StackPanel>
        </ScrollViewer>

        <StackPanel
            Grid.Row="2"
            Padding="24,12,24,20"
            HorizontalAlignment="Right"
            Orientation="Horizontal"
            Spacing="8">
            <Button Click="OnBack" Content="{x:Bind loc:SetupText.Get('Back')}" IsEnabled="{x:Bind Vm.CanGoBack, Mode=OneWay}" />
            <Button
                x:Name="NextButton"
                MinWidth="120"
                Click="OnNext"
                Content="{x:Bind Vm.NextText, Mode=OneWay}"
                IsEnabled="{x:Bind Vm.CanGoNext, Mode=OneWay}"
                Style="{StaticResource AccentButtonStyle}" />
        </StackPanel>
    </Grid>
</Window>
