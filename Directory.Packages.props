<Project>
  <!-- Central package versions. New packages need a short justification in the PR (AGENTS.md 4). -->
  <ItemGroup>
    <!-- Platform / Rendering -->
    <PackageVersion Include="Microsoft.Windows.CsWin32" Version="0.3.367" />
    <PackageVersion Include="Vortice.Direct3D11" Version="3.8.3" />
    <PackageVersion Include="Vortice.DXGI" Version="3.8.3" />
    <PackageVersion Include="Vortice.D3DCompiler" Version="3.8.3" />
    <PackageVersion Include="Vortice.DirectComposition" Version="3.8.3" />

    <!-- App -->
    <!-- Only the parts ZoomIN uses; the Microsoft.WindowsAppSDK meta-package adds ~60 MB of AI/ML/Search. -->
    <PackageVersion Include="Microsoft.WindowsAppSDK.WinUI" Version="2.6.4" />
    <PackageVersion Include="Microsoft.WindowsAppSDK.Foundation" Version="2.6.4" />
    <PackageVersion Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.28000.2957" />
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection" Version="10.0.14" />
    <PackageVersion Include="CommunityToolkit.Mvvm" Version="8.4.2" />

    <!-- Tests -->
    <PackageVersion Include="xunit.v3" Version="4.0.2" />
    <PackageVersion Include="Microsoft.Testing.Extensions.CodeCoverage" Version="18.12.0" />
    <PackageVersion Include="NetArchTest.Rules" Version="1.3.2" />
    <PackageVersion Include="BenchmarkDotNet" Version="0.15.8" />
  </ItemGroup>
</Project>
